# Default values for <<.Project.Slug>>.
#
# 這個檔案的職責是**替每個 .Values.* 宣告預設值**。`helm lint` 不帶 -f 跑的那一關就是在
# 驗這件事:少了預設值,模板在 gate 裡照樣渲染得出來(被 -f 蓋過去了),然後對任何跑
# 純 helm template 的人 nil-pointer。
#
# **namespace、environment id、Secret 名、版本號都不在這裡,而且不可以寫進來。**
# Platform 在每次 Run 疊一組保留值上來,chart 直接讀:
#
#   .Values.asgard.release               helm release 名,iac-<name>
#   .Values.asgard.releaseName           宣告裡的 name
#   .Values.asgard.namespace             Release 對到的 namespace
#   .Values.asgard.projectId             Project ID
#   .Values.asgard.projectEnvironmentId  該 Project 的 main environment ID
#   .Values.asgard.appSecretName         本 Release 專屬 Secret 名
#   .Values.asgard.appConfigMapName      本 Release 專屬 ConfigMap 名
#   .Values.asgard.ref                   觸發的 tag / branch
#   .Values.asgard.commitSha             完整 commit SHA
#   .Values.asgard.agentHubGlobalSourceSetName
#                                        Agent Hub Global Directory 的 SourceSet 名
#
# 這份 values.yaml 若自己定義 `asgard` 這個 key,Plan 會給警告並以注入值為準。
#
# 憑證與設定值一律寫 secretKeyRef / configMapKeyRef 指向上面兩個名字;那個 Secret 與
# ConfigMap 由 Platform 建立與維護,chart **不得**自己宣告它們 —— 渲染出任何非
# asgard-ai.com group 的資源會被 Plan 以 chart/kind-not-allowed 擋下。

# 模型是平台 builtin,以名字引用;沒有 CompletionModel CR,也沒有模型 API key。
# 每個 SemanticLayer 都讀這個值 —— 不要在模板裡寫死模型名。
defaultCompletionModelName: "preset-balanced"

# --- 平台上填的值 -----------------------------------------------------------
# 每個在這裡宣告了預設值、而實際值要由 Platform 提供的 key,都要在 repo 根目錄的
# .asgard-pipeline.yaml 的 chartValues 裡宣告一次,值再用 CLI 填:
#
#   asgard-cli pipeline variables set --release <name> erpDB.host db.internal
#
# 沒宣告的 key 不會被注入(Plan 給警告);宣告了必填卻沒值,Plan 以
# vars/required-missing 失敗。
#
# 每個 DataConnector 一組座標。密碼走 appSecret,不進 values、不進 git:
#
# erpDB:
#   host: ""
#   port: 5432
#   user: ""
#   database: ""
#   sslMode: "disable"
