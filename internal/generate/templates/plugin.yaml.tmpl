# <<.DisplayName>> —— 能力包
#
# A bundle a blueprint loads by name, and can choose per request. Use one when
# the same agent needs different capabilities on different turns; when the set
# is fixed, attach the skills directly and skip this.
#
# Decide the axes before the fifth bundle, because the names become the
# taxonomy. One that works: what it knows, versus how it presents.
apiVersion: asgard-ai.com/v1alpha1
kind: Plugin
metadata:
  name: <<.CRName>>
  annotations:
    # Required. Without it the CR applies cleanly and shows up nameless in the
    # UI. Only the gate rejects it.
    asgard-ai.com/plugin-name: "<<.DisplayName>>"
  labels:
    {{- include "<<.Chart>>.labels" . | nindent 4 }}
spec:
  skillSets:
    - name: sk-<<.Name>>
  # Written explicitly rather than omitted, so the bundle reads as
  # "this one carries skills only".
  toolsets: []
  sourceSetMounts: []
  hooks: []
---
apiVersion: asgard-ai.com/v1alpha1
kind: SkillSet
metadata:
  name: sk-<<.Name>>
  # No skill-set-name and no managed-by here, on purpose. A SkillSet a
  # Plugin bundles is the bundle's implementation rather than something a
  # person picks in the UI, so the platform does not present it and there is no
  # name for it to show. The 29-Plugin deployment carries none on any of them.
  # A skill set somebody is meant to choose gets its own SourceSet and its own
  # annotation - `asgard-cli add skillset` writes that one.
  labels:
    {{- include "<<.Chart>>.labels" . | nindent 4 }}
spec:
  sourceSetName: <<if .Connector>><<.Connector>><<else>>ss-skill-repos<<end>>
  searchPaths:
    # Searched recursively for SKILL.md. One path per skill keeps the set
    # explicit; a parent directory loads every skill under it.
    - TODO/
