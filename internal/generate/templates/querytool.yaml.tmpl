# <<.DisplayName>>
#
# A zero-parameter query. No user input reaches SQL, so there is no injection
# surface, which is why this shape is used for a public audience. A query that
# wants a filter gets rewritten to aggregate instead. Where one genuinely needs
# a parameter, bind it (the sql.args keys below) and never write request data
# into the sql text: a bound value cannot change the statement. It still lets
# the caller choose which rows come back.
#
# Do not ship a second tool on the same FROM/JOIN differing only in projection:
# each description then has to name the other as the alternative, and a model
# often picks the wrong one. Make the difference a column value.
apiVersion: asgard-ai.com/v1alpha1
kind: Workflow
metadata:
  name: <<.CRName>>
  annotations:
    asgard-ai.com/workflow-name: "<<.DisplayName>>"
    {{- include "<<.Chart>>.workflowSetAnnotations" (dict "name" "<<.CRName>>" "displayName" "<<.DisplayName>>") | nindent 4 }}
  labels:
    {{- include "<<.Chart>>.workflowSetLabels" (dict "name" "<<.CRName>>" "type" "automation_tool") | nindent 4 }}
    {{- with .Values.asgard.projectEnvironmentId }}
    asgard-ai.com/project-environment-id: {{ . | quote }}
    {{- end }}
    {{- include "<<.Chart>>.labels" . | nindent 4 }}
spec:
  variables: []
  entries:
    - name: entry-main
      handlingProcessor: proc-query
      labels:
        display_name: Entry
      inputSchema: |-
        {
          "type": "object",
          "properties": {}
        }
      tooling:
        name: <<.Name>>
        description: |-
          TODO: 繁體中文, to .agents/skills/plain-chinese/ - the model reads
          this to decide whether to call the tool, so an adjective here costs a
          wrong tool choice. Say what it returns, how many rows, and when to
          reach for it.
          Record the row count you measured, and when you measured it.
          Then name the tool this could be confused with, and say which to
          prefer: "for X use this, for Y use <other>". That last sentence is
          the whole difference between a set of tools a model can choose from
          and a set it guesses between - each description can be accurate on
          its own and still not say which one answers the question.
          Read them together afterwards: asgard-cli verify --tools
        allowUploadFile: false
  exits: []
  processors:
    - name: proc-query
      type: query-database
      labels:
        display_name: SQL
      configs:
        - name: dataConnector
          value: <<.Connector>>
        # Required in practice. query-database resolves a missing allowWrite to
        # true - the definitions give it a default of true and describe it as
        # permitting INSERT, UPDATE, DELETE and DDL. So a processor that omits
        # it is a write path, and the rendered chart does not show that.
        # This shape serves anonymous callers; leave it false.
        - name: allowWrite
          value: "false"
        - name: resultField
          value: rows
        - name: sql
          value: |-
            -- TODO. Run it against the live database before committing.
            -- Put the reasoning in this comment: soft deletes, why a COUNT is
            -- DISTINCT, how a path is built. There is nowhere else for it.
            select 1
        # A parameter, if one is unavoidable. The placeholder in sql depends on
        # the DataConnector's class - $1 on postgres, ? on mysql, @p1 on mssql;
        # .agents/skills/asgard-platform/wiki/processors.md has the table. Pairs
        # are numbered from 1 and read until the first gap, and the entry's
        # inputSchema has to declare the field.
        # - name: sql.args.1.type
        #   value: string
        # - name: sql.args.1.value
        #   expression: prevPayload.orderId

    # Returns the rows to the caller. `resultField` names the variable the rows
    # land in, and this processor sends it back. A query with no response
    # processor runs, succeeds, and answers nothing. Every deployed fixed query
    # tool has this pair.
    - name: proc-response
      type: push-message
      labels:
        display_name: Response
      configs:
        - name: payload
          expression: |-
            (() => {
              return rows;
            })()

  # `relationships` runs the chain. Without it the run starts at the entry's
  # handlingProcessor and stops there. The CR is valid either way, so helm
  # lint, CRD validation, the server-side dry run and `asgard-cli verify` all
  # pass while the tool returns nothing - and an agent that gets no result
  # answers from memory.
  relationships:
    - from: {processor: proc-query, relationName: success}
      to: {processor: proc-response}
<<if .ToolsetExists>># The Toolset <<.Toolset>> already exists in this chart, so it is not written
# again here: two CRs with one name means whichever applies last replaces the
# other, and the tools in the discarded copy are silently gone.
#
# Add this tool to the existing set instead - one entry under its `tools`:
#
#     - entrypoint:
#         entry: entry-main
#         workflow: <<.CRName>>
#       requestConsent: false
#
# Those two fields are the whole entry. A Toolset tool carries no name and no
# description - writing them here adds unknown fields the apiserver drops
# silently, and the tool reaches the model unnamed.
#
# Both live on the Workflow entry's `tooling` block above, which is where the
# text the model reads to choose between tools already is. Say there which
# other tool this one could be confused with.
<<else>>---
apiVersion: asgard-ai.com/v1alpha1
kind: Toolset
metadata:
  name: <<.Toolset>>
  annotations:
    asgard-ai.com/toolset-name: "<<.DisplayName>>"
    # 繁體中文, read in the customer's own console. Vocabulary rules in
    # .agents/skills/plain-chinese/ apply; the sentence-shape ones do not,
    # because this is a phrase rather than a sentence.
    asgard-ai.com/toolset-description: "TODO"
  labels:
    {{- include "<<.Chart>>.labels" . | nindent 4 }}
spec:
  toolsetClass: workflow-tooling
  # This release's own resource key, declared under `appSecret:` in
  # .asgard-pipeline.yaml. edgeserver checks it as `X-API-KEY` on this
  # resource's own endpoints, and the platform's own callers read it back from
  # the CR, so nothing else has to know it. When no use case calls those
  # endpoints from outside the platform, set a random value and ask nobody:
  #   asgard-cli pipeline variables set --release <release> --kind secret \
  #     asgard_resource_api_key --random
  # Set it before the first deploy: a key missing from the Secret resolves to an
  # empty string, and an empty key matches a request that sends none.
  # Never `preset-agent-hub`: that is Agent Hub's own credential. Nor is this the
  # X-API-KEY the documentation tells you to create. See
  # `.agents/skills/asgard-platform/usecase/conventions.md`.
  apiKey:
    valueFrom:
      secretKeyRef:
        name: {{ include "<<.Chart>>.appSecretName" . }}
        key: asgard_resource_api_key
  tools:
    - entrypoint:
        entry: entry-main
        workflow: <<.CRName>>
      requestConsent: false
<<end>>