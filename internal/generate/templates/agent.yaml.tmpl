# <<.DisplayName>>
#
# An Agent CR is a capability group: the tools, skills and data one area of work
# needs, plus the guidance for working in it. It deploys nothing and is not a
# separate assistant. The entry point is the platform's per-namespace
# preset-agent-hub, the caller selects agents per turn with
# payload.agent_hub.agent_names[], and the agent of that turn holds every
# selected Agent's capabilities and does the work itself.
#
# TODO before this is usable:
#   1. description - what this capability covers, in the customer's business
#      nouns. The agent reads it to decide when this guidance applies. Do not
#      name tools, skills or semantic models: the platform lists them beside it.
#      Where another agent looks similar, say which side of the line each is on.
#   2. prompt - only what is specific to this area of work. Every selected
#      Agent's prompt is shown to the same agent in one turn, so a block copied
#      into each Agent is repeated once per Agent. Rules for every turn belong
#      in the Global Directory's AGENTS.md, which `asgard-cli add agentsmd`
#      writes from this chart.
#   3. At least two sampleQuestions while published.
apiVersion: asgard-ai.com/v1alpha1
kind: Agent
metadata:
  name: <<.CRName>>
  annotations:
    asgard-ai.com/agent-name: "<<.DisplayName>>"
  labels:
    # The on/off switch: callers build agent_names[] from the published agents.
    asgard-ai.com/agent-published: "true"
    {{- include "<<.Chart>>.labels" . | nindent 4 }}
spec:
  agentClass: managed
  managed:
    # The handle a user writes as @<aliasName> to point at this capability.
    # Convention: the CR name without its ag- prefix.
    aliasName: <<.Name>>
    description: |-
      TODO: what this capability covers.
    # Every field below is 繁體中文, and the agent answers in the register its
    # prompt is written in. Write them to .agents/skills/plain-chinese/ - an
    # agent whose prompt says 賦能 and 至關重要 uses those words in its answers
    # to customers.
    prompt:
      persona: |-
        TODO: who this agent is. Per agent.
      task: |-
        TODO: the operating rules for this area of work.
      context: |-
        TODO: what it can reach. Per agent.
      format: |-
        TODO: how to answer, where this area needs its own form.
    # Shown to the end user in Sindri before anything else this agent says, so
    # they are 繁體中文. Write real questions somebody would type, to
    # .agents/skills/plain-chinese/ - not 「如何提升營運效率?」, which nobody
    # asks and which the agent cannot answer.
    sampleQuestions:
      - TODO
      - TODO
<<if .SkillSets>>    skillSetNames:
<<range .SkillSets>>      - <<.>>
<<end>><<else>>    # No SkillSet in this chart yet, so none is referenced: a name that does not
    # exist is a dangling reference the gate rejects.
    #
    # An Agent is allowed to have none. But a release with no Syncer has
    # nothing running after the platform's dry run: apply fires the Syncers
    # this release deploys that carry auto-fire-on-rollout and waits for them,
    # so with none a succeeded run means helm returned. A SkillSet brings one,
    # so a project heading for a deploy wants one:
    #
    #     asgard-cli add skillset base --repo <git url>
    #
    # Then add it here.
    # skillSetNames:
    #   - sk-base
<<end>><<if .Layer>>    # At most one layer per agent, to keep the search space small.
    # No allowedCubes - any table in this layer is queryable.
    semanticLayers:
      - name: <<.Layer>>
        allowQuery: true
        allowWrite: false
<<else>>    # No semantic layer. An agent needs at least one capability source, so give
    # it toolsetNames instead, or the gate rejects it.
    # toolsetNames:
    #   - ts-<name>
<<end>>
    # The Neko browser sidecar, for a system that has no database to read and
    # no API - only a web console. The flag is easy; the work is the reference
    # documents the agent needs to drive that UI, so none is written here. A plain boolean on an Agent and a `value:` string on a
    # SandboxBlueprint -
    # `.agents/skills/asgard-platform/usecase/browser-operation.md` has both
    # spellings, which of the two settings wins, and when a web UI is the right
    # route at all.
    # browser:
    #   enabled: true

    # Files from a SourceSet, mounted into the sandbox pod of every turn that
    # selects this Agent. The mount is a choice about what this agent works on,
    # so none is written.
    #
    # A YAML list here. The same field on a SandboxBlueprint is a stringified
    # JSON array, and people copy one shape into the other - both shapes are side by side in
    # `.agents/skills/asgard-platform/usecase/conventions.md`, which also has
    # where a mount may go and the one parent directory that kills the driver.
    #
    # sourceSetName, mountPath and readOnly are required on every entry, and
    # mountPath must match `^/.+`. Two entries resolving to one mountPath are
    # deduplicated silently, first one wins, so a collision shows up as a
    # missing mount. subPath mounts a slice of the store rather than
    # all of it - the only mechanism that does - and a rejected one takes the
    # whole Sandbox not-ready rather than skipping the entry; the same page has
    # what it rejects.
    # sourceSetMounts:
    #   - sourceSetName: ss-<name>
    #     mountPath: /knowledge
    #     readOnly: true
    #     subPath: <dir>/
