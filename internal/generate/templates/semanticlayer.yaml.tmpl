# <<.DisplayName>>
#
# TODO before this is usable:
#   1. Introspect the real database. Do not guess a schema - see
#      .agents/skills/semantic-layer-modeling/
#   2. One cube per table, with a description in the customer's language on
#      every cube, dimension and measure. A dimension without one is invisible
#      to the model.
#   3. Run every sampleQuery against the live database before committing it.
#
# Business rules the column names do not convey go in `instruction` - which
# table not to trust, which join fans out, which view does not push filters down.
apiVersion: asgard-ai.com/v1alpha1
kind: SemanticLayer
metadata:
  name: <<.CRName>>
  annotations:
    asgard-ai.com/semantic-layer-name: "<<.DisplayName>>"
  labels:
    {{- include "<<.Chart>>.labels" . | nindent 4 }}
spec:
  # Required on a SemanticLayer, unlike an Agent. Never hardcode a model name.
  completionModelName: {{ .Values.defaultCompletionModelName | quote }}
  # Omitting effort is not the same as medium: it sends no effort at all and
  # the model's own default applies.
  effort: {{ .Values.defaultSemanticLayerEffort | quote }}
  dataConnectorName: <<.Connector>>
  locale: zh-TW
  timezone: Asia/Taipei
  # The summary, the instruction, and every title and description in this file,
  # are 繁體中文 the model reads to choose what to query - see
  # .agents/skills/plain-chinese/. Here vague language produces wrong answers:
  # 「至關重要的訂單資料」tells the model nothing it can select on, and
  # 「每筆訂單一列,含成立時間與出貨狀態」does.
  #
  # summary is how the model chooses between layers, not a description of this
  # one - the same job the Agent CRD gives description. The tool it
  # lists them with, list_database_semantic_models, returns {model_name,
  # summary} and nothing else - so with a second layer mounted, an empty one
  # leaves the model to choose on the CR name alone, before any cube is
  # visible. Name the systems and the entities it covers.
  #
  # Optional to the apiserver, so it is often left out.
  summary: |-
    TODO: which systems and entities this layer covers.
  instruction: |-
    TODO: rules a reader cannot get from the column names.
  cubes:
    - name: <schema>.<table>
      sqlTable: <schema>.<table>
      title: TODO
      description: TODO
      # Each entry is the name of a dimension below; `asgard-cli verify` fails
      # one that names no dimension of this cube.
      primaryKeyDimensions: [<Column>]
      dimensions:
        # name is the column the sql selects, never a re-cased alias.
        - name: <Column>
          sql: '{CUBE}.<Column>'
          title: TODO
          description: TODO
          type: string
      # Required on every cube, even a cube that is only ever read row by row.
      # The apiserver accepts an empty list and rejects an omitted key, and helm
      # lint does not see the difference. But with `[]` the layer answers no
      # aggregate question: a cube with dimensions and no measures gives the
      # model columns to group by and nothing to aggregate.
      #
      # Every measure needs sql except type: count, which counts rows and takes
      # none. The CEL rule rejects the wrong combination at apply time.
      #
      # The shape of one entry. name, title, description and type are required
      # on every one, and sql for every type but count. The model reads
      # `description` to pick between two measures that aggregate the same
      # column, so without one it guesses:
      #
      #   - name: revenue              # unique inside the cube
      #     title: Revenue             # what a person sees
      #     description: |-
      #       TODO: net of refunds, or gross? Say which, and in what currency.
      #     type: sum                  # string|time|boolean|number|number_agg|
      #                                # count|count_distinct|
      #                                # count_distinct_approx|sum|avg|min|max
      #     sql: amount                # required unless type is count
      #
      # The three below are for specific cases, not for every measure. Use one
      # when the question needs it: a currency or percent that a bare number
      # misrepresents, a business term that is one name and one
      # predicate, or a "show me the rows" that has to expand to something:
      #
      #     format: currency           # currency|percent, and nothing else
      #     filters:
      #       - sql: "{CUBE}.status = 'paid'"
      #     drillMembers: [order_id]
      measures: []
  # Analysis views go here, never as a cube-level sql: virtual cube. Both
  # fields of an entry are required.
  #
  # Run every one against the live database before committing it, and put the
  # row count you saw in the comment - a query returning 89 rows sets a
  # different expectation from one returning 4. One that errors or returns
  # nonsense misleads the agent reading it.
  #
  #   - comment: TODO: what it answers, and what the numbers leave out
  #     sql: |
  #       select ...
  sampleQueries: []
  # Plain strings. Data Insight renders each as a button under this layer's
  # prompt box and sends it when somebody clicks it, so an empty list shows a
  # blank page to whoever opens the layer. Optional to the apiserver, and the
  # most useful optional field when a person is the consumer.
  #
  # Not the Agent CRD's managed.sampleQuestions: same name, different CR, and
  # the two-question minimum that `gate` R7 enforces there does not apply here.
  sampleQuestions: []
  # Required, as measures is: a single-cube layer still has to
  # say `joins: []` rather than leave the key out.
  #
  # Every field of an entry is required, each `cube` is a cube's own `name`
  # as spelled above, and each entry in `dimensions` is a dimension `name` on
  # that cube. The CRD checks only that the two `dimensions` lists are the same
  # length, so a composite key is written out on both sides; `asgard-cli verify`
  # fails a join whose cube or dimension this layer does not declare.
  #
  # Verify the relationship with a join query before writing an entry. Foreign
  # keys are often absent in older business systems, so a relationship inferred
  # from column naming is a guess, and a wrong one_to_many fans rows out and
  # silently inflates every count that crosses it. The column names do not show
  # this, which is why
  # .agents/skills/asgard-platform/usecase/semantic-layer.md says to introspect
  # the database rather than reason about it.
  #
  #   - name: <from_cube>_<from_dim>_<to_cube>_<to_dim>
  #     description: TODO, in the customer's language
  #     relationship: one_to_many   # or one_to_one, or many_to_one
  #     from:
  #       cube: <schema>.<table_a>
  #       dimensions: [<col>]
  #     to:
  #       cube: <schema>.<table_b>
  #       dimensions: [<col>]
  joins: []
