# <<.DisplayName>> —— 對話流程
#
# The prompt lives here, on the processor. The single-purpose shape has no
# Agent CR; with --supervisor, the Agents are listed on the blueprint.
#
# Keep the graph minimal: greet, listen, answer, back to listen. Telling topics
# apart is the agent's job, informed by the prompt - a workflow per topic puts
# that decision in two places.
#
# Without the workflow-set labels below, this workflow belongs to no set and the
# UI has nothing to list, although it runs. Lint, CRD validation and a dry-run
# do not report this.
apiVersion: asgard-ai.com/v1alpha1
kind: Workflow
metadata:
  name: wf-<<.Name>>
  annotations:
    asgard-ai.com/workflow-name: "<<.DisplayName>>"
    {{- include "<<.Chart>>.workflowSetAnnotations" (dict "name" "wf-<<.Name>>" "displayName" "<<.DisplayName>>") | nindent 4 }}
  labels:
    {{- include "<<.Chart>>.workflowSetLabels" (dict "name" "wf-<<.Name>>" "type" "bot") | nindent 4 }}
    {{- with .Values.asgard.projectEnvironmentId }}
    asgard-ai.com/project-environment-id: {{ . | quote }}
    {{- end }}
    {{- include "<<.Chart>>.labels" . | nindent 4 }}
spec:
<<if .Supervisor>>  # The supervisor loop: four processors and five relationships, identical
  # edge for edge in the prod values of three deployments.
  # `.agents/skills/asgard-platform/usecase/flow-agent-supervisor.md`
  # has why each edge is where it is; this is that shape with the prompt left TODO.
  #
  # It has no exits on purpose: 14 of the 17 Workflows across
  # every reference deployment declare none, and a run ends when its terminal
  # processor finishes.
  variables: []
  entries:
    - name: entry-main
      handlingProcessor: proc-init
      labels:
        display_name: Entry
        description: "TODO: 這條流程從哪裡開始"
  exits: []
  processors:
    # Primes the context once, before the first answer. It takes no configs.
    - name: proc-init
      type: update-context
      labels:
        display_name: 初始化
      configs: []

    - name: proc-agent
      type: stream-llm-completion-message
      labels:
        display_name: 總管
      configs:
        - name: completionModel
          value: {{ .Values.defaultCompletionModelName | quote }}
        # The entry agent's own instruction, and the one place for rules that
        # hold on every turn. The platform shows this agent each Agent on the
        # blueprint - its description, its prompt and the tools it provides -
        # so this prompt does not repeat them, and they do not repeat this.
        - name: prompt
          template: |-
            TODO: who this agent is, in 繁體中文 written to
            .agents/skills/plain-chinese/. Say that it works through its tools
            rather than from memory, and the rules every turn follows - by
            what they are for, never by CR or agent names.
        # The deployments set these two identically. The processor waits for the
        # whole reply without being told to; production charts that still set
        # `await` carry a key the platform no longer reads - see
        # `.agents/skills/asgard-platform/wiki/processors.md`.
        - name: maxTokens
          value: "60000"
        - name: effort
          value: medium
        # Capabilities live one CR further out, on the blueprint - including the
        # Agents. Do not also declare toolsets here.
        - name: sandboxBlueprint
          value: sbp-<<.Name>>

    # A turn that failed says so and stays in the loop. This is a processor of
    # its own so that a failed run and an answered one look different to the
    # caller.
    - name: proc-error
      type: push-message
      labels:
        display_name: 錯誤回覆
      configs:
        - name: message
          value: "TODO: 一句對使用者說的話,不要技術細節"
        - name: payload
          expression: |-
            (() => {
              return { prevError };
            })()
        - name: flush
          value: "true"

    # Waits for the next turn and hands back to the completion processor, which
    # makes this a conversation rather than one request.
    - name: proc-listen
      type: listen-message
      labels:
        display_name: 等待下一輪
      configs: []

  relationships:
    - from: {processor: proc-init, relationName: success}
      to: {processor: proc-agent}
    - from: {processor: proc-agent, relationName: success}
      to: {processor: proc-listen}
    - from: {processor: proc-agent, relationName: failure}
      to: {processor: proc-error}
    - from: {processor: proc-listen, relationName: success}
      to: {processor: proc-agent}
    - from: {processor: proc-error, relationName: success}
      to: {processor: proc-listen}
<<else>>
  variables: []
  entries:
    - name: entry-main
      handlingProcessor: proc-answer
      labels:
        display_name: Entry
  exits: []
  processors:
    - name: proc-answer
      type: stream-llm-completion-message
      labels:
        display_name: 回答
      configs:
        # Required, with no default. A processor without it is rejected. The
        # values key is the same one every SemanticLayer reads, so one change of
        # model moves the whole project.
        - name: completionModel
          value: {{ .Values.defaultCompletionModelName | quote }}
        # Capabilities live one CR further out, on the blueprint. Do not also
        # declare toolsets here - a second declaration of the same capability
        # drifts from the first.
        - name: sandboxBlueprint
          value: sbp-<<.Name>>
<<if .Layer>>        # A layer mounts here rather than on the blueprint: a Flow Agent has no
        # Agent CR, so this processor is where the read path attaches.
        # allowWrite: false is not optional - omitting it resolves to true.
        - name: semanticLayers
          expression: '[{"name": "<<.Layer>>", "allowQuery": true, "allowWrite": false}]'
<<else>>        # A Flow Agent mounts its layer here, not on the blueprint. Pass
        # --layer sl-<name> to have this written for you.
        # allowWrite: false is not optional - omitting it resolves to true.
        # - name: semanticLayers
        #   expression: '[{"name": "sl-<name>", "allowQuery": true, "allowWrite": false}]'
<<end>>
        - name: prompt
          value: |-
            TODO: four sections that do not overlap, in 繁體中文 written to
            .agents/skills/plain-chinese/ - this agent answers in the register
            its prompt is written in, so slop here reaches every conversation.
              identity      who this is, and that it works through tools rather
                            than from memory
              tool choice   which kind of question goes to which capability,
                            described by what it does, NOT by CR or tool names
              data meaning  what the numbers mean, what is excluded, how fresh
                            they are, and what to say when something is missing
              format        how to answer, and what never to say
            Keep it high-level: naming a tool here means editing the prompt
            every time the tools change.
<<end>>