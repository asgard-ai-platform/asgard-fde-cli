# <<.DisplayName>> —— 能力宣告
#
# Everything this entry point can do is declared here, one CR out from the
# workflow. The Workflow CRD does not contain the link, so searching it finds
# nothing.
#
# A single-purpose agent needs no Agent CR: its prompt is on the workflow and
# its capabilities are here. Several areas of work, each with its own
# guidance, is a different shape -
# `.agents/skills/asgard-platform/usecase/flow-agent-supervisor.md`.
apiVersion: asgard-ai.com/v1alpha1
kind: SandboxBlueprint
metadata:
  name: sbp-<<.Name>>
  annotations:
    asgard-ai.com/sandbox-blueprint-name: "<<.DisplayName>> 能力"
  labels:
    {{- include "<<.Chart>>.labels" . | nindent 4 }}
spec:
  # Comma-separated strings, not lists.
<<if .Toolset>>  toolsetNames:
    value: "<<.Toolset>>"
<<else>>  # toolsetNames:
  #   value: "ts-<name>"
<<end>><<if .SkillSets>>  skillSetNames:
    value: "<<join .SkillSets ", ">>"
<<else>>  # No SkillSet in this chart yet, so none is referenced: a name that does not
  # exist is a dangling reference, and the gate rejects it.
  #
  # A release with no Syncer has nothing running after the platform's dry
  # run: apply fires the Syncers this release deploys that carry
  # auto-fire-on-rollout and waits for them, so with none a succeeded run means
  # helm returned. A SkillSet brings one, so a project heading for a deploy
  # wants one:
  #
  #     asgard-cli add skillset base --repo <git url>
  #
  # Then name it here, comma-separated.
  # skillSetNames:
  #   value: "sk-base"
<<end>>  # The Plugin bundles this entry point loads, comma-separated like the two
  # above. An `expression:` picks them per turn out of the caller's payload,
  # which is what a bundle is for.
  # `.agents/skills/asgard-platform/usecase/plugin.md` has both forms, and the
  # question to settle before the payload decides anything.
  # pluginNames:
  #   value: "pg-<domain>"
  #
  # The Neko browser sidecar, for an entry point whose only route into a system
  # is that system's web console. A `value:` string here and a plain boolean on
  # an Agent CR, and people copy one into the other -
  # `.agents/skills/asgard-platform/usecase/browser-operation.md` has both
  # spellings, which of the two settings wins, and when a web UI is the right
  # route at all.
  # browser:
  #   enabled:
  #     value: "true"
  #
  # A JSON string the controller unmarshals. Keep readOnly true: an agent that
  # answers questions about knowledge has no reason to be able to change it.
  # sourceSetMounts:
  #   value: '[{"sourceSetName": "ss-<name>", "mountPath": "/knowledge", "readOnly": true}]'
  #
  # The Agents: one capability group per area of work, each bringing its
  # tools, skills and data plus the guidance for that area. The agent of
  # every turn holds all of them and does the work itself.
  # `add flowagent --supervisor` writes the workflow and stops there, because
  # choosing the areas and the line between them is a design decision -
  # `.agents/skills/asgard-platform/usecase/flow-agent-supervisor.md` has how
  # to split them and what each entry may override.
  #
  # A JSON string as well, like sourceSetMounts above. People often write it
  # as a YAML list because its contents look like one. Each entry carries
  # exactly one of baseAgentName - an Agent CR in this
  # chart, every other field on the entry then a delta merged onto it - or
  # aliasName, a capability group with no CR at all, defined entirely by the
  # entry.
  # agents:
  #   value: |-
  #     [{"baseAgentName": "ag-<area>"},
  #      {"baseAgentName": "ag-<other>"}]
  #
  # An `expression:` computes the list per turn from the caller's payload
  # instead, and `template:` is the third form. The CRD takes exactly one of
  # the three, so swapping forms means deleting the one in place.
