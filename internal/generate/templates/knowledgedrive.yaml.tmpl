# <<.DisplayName>> —— 知識 Drive
#
# Unstructured knowledge: documents, FAQs, pages. Not anything a query answers
# exactly - counts, prices, stock, contact details belong to a query tool, and
# putting them here makes the agent paraphrase a number it should have read.
#
# KnowledgeBase is still a live CRD and a shipping console feature - preferring
# this Drive is one engagement's experience, not a platform rule. See
# `.agents/skills/asgard-platform/wiki/knowledge.md` for the comparison, and
# `.agents/skills/asgard-platform/usecase/knowledge-base.md` for the older
# shape itself and why `add` has no generator for it.
apiVersion: asgard-ai.com/v1alpha1
kind: SourceSet
metadata:
  name: <<.CRName>>
  annotations:
    asgard-ai.com/source-set-name: "<<.DisplayName>>"
    # 繁體中文, read in the customer's own console. Vocabulary rules in
    # .agents/skills/plain-chinese/ apply; the sentence-shape ones do not,
    # because this is a phrase rather than a sentence.
    asgard-ai.com/source-set-description: "TODO: what knowledge this holds"
  labels:
    # To pause indexing, set this label. Do not remove the contextIndex field -
    # clearing it tears down the derived CRs and renames the index aside.
    asgard-ai.com/context-index-suspend: {{ .Values.<<.ValuesKey>>.contextIndex.suspend | quote }}
    {{- include "<<.Chart>>.labels" . | nindent 4 }}
spec:
  # This release's own resource key, declared under `appSecret:` in
  # .asgard-pipeline.yaml. edgeserver checks it as `X-API-KEY` on this
  # resource's own endpoints, and the platform's own callers read it back from
  # the CR, so nothing else has to know it. When no use case calls those
  # endpoints from outside the platform, set a random value and ask nobody:
  #   asgard-cli pipeline variables set --release <release> --kind secret \
  #     asgard_resource_api_key --random
  # Set it before the first deploy: a key missing from the Secret resolves to an
  # empty string, and an empty key matches a request that sends none.
  # Never `preset-agent-hub`: that is Agent Hub's own credential. Nor is this the
  # X-API-KEY the documentation tells you to create. See
  # `.agents/skills/asgard-platform/usecase/conventions.md`.
  apiKey:
    valueFrom:
      secretKeyRef:
        name: {{ include "<<.Chart>>.appSecretName" . }}
        key: asgard_resource_api_key
  # No member registry: what is in the Drive is whatever its Syncers write, plus
  # anything uploaded by hand. The paths are the only record.
  #
  # Setting contextIndex derives three same-named CRs that mount the Drive
  # writable and build the knowledge graph on a cron.
  contextIndex:
    cron:
      schedule: {{ .Values.<<.ValuesKey>>.contextIndex.schedule | quote }}
      timeZone: {{ .Values.<<.ValuesKey>>.timeZone | quote }}
    prompt: |-
      TODO: domain knowledge only, in 繁體中文 written to
      .agents/skills/plain-chinese/ - this is appended to the platform's own
      indexing instructions. Three things earn their place:
        - what each folder holds, one line each
        - the key, and which copy wins. With incremental sync the same record
          appears in several dated partitions - say which one is current, or
          the graph treats stale versions as facts
        - what a field means where the name does not carry it
    # includePaths:            # only when a Syncer brings in more than the
    #   - repos/handbook/docs/ # knowledge; absent indexes the whole Drive
---
# One Syncer per folder that is filled automatically. A folder people upload to
# by hand needs no Syncer at all.
#
# This one is class `database`. A folder filled from the open web is a second
# Syncer document in this file, of class `web`. It is not written here because
# the page list has to be chosen - a guessed one indexes the wrong site, and
# nothing downstream reports that:
#
#   syncerClass: web
#   destinationPath: "website/"   # trailing slash, as for a database syncer
#   web:
#     timeoutMs: 30000            # both required, and neither has a default
#     waitForMs: 3000             # how long a page gets to settle after loading
#     urls: [ ... ]               # exactly one of urls and siteMapUrl
#
# The whole document, the labels it needs, the rest of the syncer classes, and
# why the page list belongs in the chart rather than behind a siteMapUrl crawl,
# are in .agents/skills/asgard-platform/usecase/knowledge-drive.md.
apiVersion: asgard-ai.com/v1alpha1
kind: Syncer
metadata:
  name: syn-<<.Name>>-db
  annotations:
    asgard-ai.com/syncer-name: "<<.DisplayName>> 資料同步"
  labels:
    # Two switches, and neither reads the other.
    #
    # suspend stops the scheduler. auto-fire-on-rollout is read only by the
    # platform's apply step, which fires this Syncer once per deploy and waits
    # for it - firing works on a suspended CronJob. So suspend plus auto-fire
    # is a Syncer that runs on deploys and never on a clock, and a suspended
    # Syncer without auto-fire never runs at all.
    #
    # Auto-fire is set here so the first deploy loads the drive, rather than
    # the drive staying empty until the next scheduled tick.
    asgard-ai.com/syncer-suspend: {{ .Values.<<.ValuesKey>>.dbSync.suspend | quote }}
    asgard-ai.com/auto-fire-on-rollout: "true"
    {{- include "<<.Chart>>.labels" . | nindent 4 }}
spec:
  sourceSetName: <<.CRName>>
  # Relative path inside the volume: no leading /, no . or .. segment, no //.
  # Must end with / for a database or web syncer.
  destinationPath: "data/"
  # Where the incremental cursor lives. Must not end with /.
  statePath: ".syncer-state/<<.Name>>-db"
  syncerClass: database
  schedule: {{ .Values.<<.ValuesKey>>.dbSync.schedule | quote }}
  timeZone: {{ .Values.<<.ValuesKey>>.timeZone | quote }}
  database:
    dataConnectorName: <<.Connector>>
    batchSize: {{ .Values.<<.ValuesKey>>.dbSync.batchSize }}
    # Immutable - the CRD checks self == oldSelf, so changing the projection
    # means a new Syncer, not an edit.
    #
    # Both flags belong to a column. isMaxValueColumn written one level up,
    # beside dataConnectorName, is an unknown field: the apiserver drops it
    # silently and the Syncer then re-reads the whole table every run.
    columns:
      - name: TODO
        # The primary key. A schema-level marker only, but it records which
        # column carries row identity.
        isIdentifier: true
      - name: TODO
        # The cursor, strictly greater than: a run with no changes writes
        # nothing. At most one column may carry this.
        isMaxValueColumn: true
    # The Syncer wraps this query:
    #
    #   select <columns> from (query) where <cursor> > $cursor
    #   order by <cursor> asc
    #
    # so every name in columns must appear in the projection spelled exactly
    # the same way, and the cursor column has to be comparable.
    query: |-
      -- TODO. Run it against the live database before committing, and record
      -- the row count you measured and when.
      select 1
