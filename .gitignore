# ---- Generated files ---------------------------------------------------
# Everything produced by a command or a test; see AGENTS.md
/.out/

# ---- Local working state -----------------------------------------------
# Worktrees created inside the checkout. Nothing under here is committable,
# and while one exists this checkout has untracked files - which every binary
# built from it then carries, because `go install` resolves the VCS root to
# this checkout even when it is run from inside the worktree. `asgard-cli
# version` reports `+dirty` for a tree nobody edited, in the very line
# `issue-report` asks somebody to paste.
/.claude/worktrees/

# ---- Build output ------------------------------------------------------
# GoReleaser output directory
/dist/
# Binaries from a local `go build`
/asgard-cli
/asgard-cli.exe
# Safety net for binaries built directly under cmd/
/cmd/*/asgard-cli
/cmd/*/*.exe

# ---- Go toolchain ------------------------------------------------------
# go.work is a personal multi-module setup and must not affect anyone else
go.work
go.work.sum
# Note: vendor/ is deliberately not ignored. If vendoring is ever enabled,
# those dependencies belong in version control.

# ---- Tests, coverage, profiling ----------------------------------------
*.test
coverage.out
coverage.txt
coverage.html
*.cover
# Output of `go test -cpuprofile` and friends
*.prof
*.pprof

# ---- Secrets and local config ------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
# Local-only config; commit example files as *.example.yaml instead.
# Note: .asgard-config.json is deliberately not ignored. It is project
# configuration and belongs in version control.
config.local.*

# ---- Editors / IDEs ----------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~

# ---- Operating system --------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# ---- Python bytecode ---------------------------------------------------
# Written next to the db-query scripts under internal/scaffold/templates the
# moment one is run in place, and `go:embed all:` would embed it.
__pycache__/
*.pyc

# **A scaffolded repository inside this one.** `asgard-cli init` run in this
# checkout - by hand, or by a check that forgot to cd - writes a whole customer
# repository here: .agents/skills/ gains the seven design-time skills this repo
# only ships, and assets/, docs/, projects/, references/, requirements/ and
# plugins/ appear at the root. It happened once and `git add -A` committed 117
# files of it. None of these is a directory this repository has of its own, so
# ignoring them costs nothing and stops the next one.
#
# `go run ./hack pass-list` is the other half: it fails when a skill this repo
# ships is also in .agents/skills/, which is what caught it.
/.asgard-scaffold.json
/.asgard-pipeline.yaml
/.asgard-cli.yaml
/.claude-plugin/
/assets/
/docs/
/plugins/
/projects/
/references/
/requirements/
/.agents/skills/asgard-platform/
/.agents/skills/asgard-fde-onboarding/
/.agents/skills/db-query/
/.agents/skills/llm-wiki/
/.agents/skills/plain-chinese/
/.agents/skills/proposal-deck/
/.agents/skills/semantic-layer-modeling/
/.agents/skills/spec-workflow/
/.gitattributes
